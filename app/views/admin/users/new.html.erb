<h2>Invite New User</h2>

<%= form_with(model: [:admin, @user], url: admin_users_path, local: true, style: "background: white; padding: 2rem; border-radius: 8px; max-width: 500px;") do |f| %>
  <div style="margin-bottom: 1rem;">
    <%= f.label :name, style: "display: block; font-weight: bold; margin-bottom: 0.5rem;" %>
    <%= f.text_field :name, required: true, style: "width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;" %>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= f.label :email, style: "display: block; font-weight: bold; margin-bottom: 0.5rem;" %>
    <%= f.email_field :email, required: true, style: "width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;" %>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= f.label :role, style: "display: block; font-weight: bold; margin-bottom: 0.5rem;" %>
    <%= f.select :role, [["Buyer", "buyer"], ["Admin", "admin"]], {}, style: "width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;" %>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= f.label :billing_day, "Billing Day (1 - 30)", style: "display: block; font-weight: bold; margin-bottom: 0.5rem;" %>
    <%= f.number_field :billing_day, in: 1..30, value: 1, style: "width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;" %>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= f.label :profile_photo, style: "display: block; font-weight: bold; margin-bottom: 0.5rem;" %>
    <%= f.file_field :profile_photo %>
  </div>

  <%= f.submit "Send Invitation Email", style: "background: #2563eb; color: white; padding: 0.75rem 1.5rem; border: none; border-radius: 4px; cursor: pointer; width: 100%;" %>
<% end %>