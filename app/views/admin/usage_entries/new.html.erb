<h2>Record Feature Usage</h2>

<%= form_with(model: [:admin, @usage_entry], local: true, style: "background: white; padding: 2rem; border-radius: 8px; max-width: 500px;") do |f| %>
  <div style="margin-bottom: 1rem;">
    <%= f.label :subscription_id, "Select Buyer Active Subscription", style: "display: block; font-weight: bold; margin-bottom: 0.5rem;" %>
    <%= f.collection_select :subscription_id, @subscriptions, :id, ->(s) { "#{s.user.name} - #{s.plan.name}" }, { prompt: "Select Subscription" }, { required: true, style: "width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;" } %>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= f.label :feature_id, "Select Feature", style: "display: block; font-weight: bold; margin-bottom: 0.5rem;" %>
    <%= f.collection_select :feature_id, @features, :id, :name, { prompt: "Select Feature" }, { required: true, style: "width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;" } %>
  </div>

  <div style="margin-bottom: 1rem;">
    <%= f.label :units_used, "Units Used", style: "display: block; font-weight: bold; margin-bottom: 0.5rem;" %>
    <%= f.number_field :units_used, required: true, min: 1, style: "width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;" %>
  </div>

  <div style="margin-bottom: 1.5rem;">
    <%= f.label :recorded_for_period, "Date", style: "display: block; font-weight: bold; margin-bottom: 0.5rem;" %>
    <%= f.date_field :recorded_for_period, value: Date.today, style: "width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;" %>
  </div>

  <%= f.submit "Record Usage", style: "background: #2563eb; color: white; padding: 0.75rem 1.5rem; border: none; border-radius: 4px; cursor: pointer; width: 100%;" %>
<% end %>
