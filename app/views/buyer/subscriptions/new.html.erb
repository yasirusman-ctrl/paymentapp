<h2>Subscribe to a Plan</h2>

<%= form_with(model: [:buyer, @subscription], local: true, style: "background: white; padding: 2rem; border-radius: 8px; max-width: 500px;") do |f| %>
  <div style="margin-bottom: 1.5rem;">
    <%= f.label :plan_id, "Select Plan", style: "display: block; font-weight: bold; margin-bottom: 0.5rem;" %>
    <%= f.collection_select :plan_id, @plans, :id, ->(p) { "#{p.name} - $#{sprintf('%.2f', p.monthly_fee)}/mo" }, { prompt: "Choose a Plan" }, { required: true, style: "width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;" } %>
  </div>

  <p style="font-size: 0.9rem; color: #64748b; margin-bottom: 1.5rem;">
    <strong>Notice:</strong> Subscribing will immediately charge your authorized Stripe card for the first month's plan fee and issue an email invoice receipt.
  </p>

  <%= f.submit "Confirm & Subscribe Now", style: "background: #10b981; color: white; padding: 0.75rem 1.5rem; border: none; border-radius: 4px; cursor: pointer; width: 100%;" %>
<% end %>
