# See https://help.github.com/articles/ignoring-files for more about ignoring files.
# Keep this file minimal and avoid committing secrets or generated files.

# Bundler
/.bundle
/vendor/bundle

# dotenv / env files
/.env*

# Byebug
/.byebug_history

# Logs and temp files (keep the .keep placeholders)
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep

# Pids
/tmp/pids/*
!/tmp/pids/.keep

# Active Storage (uploaded files)
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Public compiled assets
/public/assets
/public/packs
/public/packs-test

# Node and Yarn
/node_modules
/yarn-error.log

# Cache and build directories
.parcel-cache
.cache

# Ignore Rails master key and other key files
/config/master.key
/config/*.key

# Ignore SQLite databases
/db/*.sqlite3
/db/*.sqlite3-journal

# Coverage
/coverage/

# Editor and OS files
*.swp
*~
.DS_Store
.idea/
.vscode/
*.iml

# Misc
/public/system

